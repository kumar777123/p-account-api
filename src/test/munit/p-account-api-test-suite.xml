	<munit:config name="p-account-api-test-suite.xml" />
	<munit:test name="p-account-api-test-suite-post:\accounts:application\json:p-account-api-configTest" doc:id="0a49c9f1-ace7-4218-bd57-207432386e66" description="Test">
		<munit:behavior >
			<munit-tools:spy doc:name="Spy" doc:id="16ecb7ef-69e3-4189-a331-be8bb6369f8d" processor="ee:transform">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="map-request payload" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:before-call>
					<munit-tools:assert-equals doc:name="Assert equals" doc:id="cbde6971-d8ad-4b9f-86a5-94780d310616" actual="#[payload.name[0] as String]" expected='#[%dw 2.0&#10;output application/json&#10;---&#10;"STG Technologies Pvt Ltd"]'/>
				</munit-tools:before-call>
				<munit-tools:after-call>
					<munit-tools:assert-equals doc:name="Assert equals" doc:id="9ec6acb0-30ff-46bd-bd99-cb37a320ee77" actual="#[payload.Name[0]]" expected='#[%dw 2.0&#10;output application/json&#10;---&#10;"STG Technologies Pvt Ltd"]'/>
				</munit-tools:after-call>
			</munit-tools:spy>
			<munit-tools:mock-when doc:name="call s-oauth-api" doc:id="3a977449-e1d4-4e43-a3fd-6c17944da0c7" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="call s-oauth-api" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:variables >
						<munit-tools:variable key="accessToken" value="#[readUrl('classpath://oauth_response.json')]" mediaType="application/json" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="call s-account-api" doc:id="da10b3fd-7c55-49e6-8a0c-6504b4241e68" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="call s-account-api" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[MunitTools::getResourceAsString('postAccountResponce.json')]" mediaType="application/json" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="1b20867b-b0ac-46f6-b0ed-d504a10cc9c0" >
				<munit:payload value="#[MunitTools::getResourceAsString('postAccountReuest.json')]" mediaType="application/json" />
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to post:\accounts:application\json:p-account-api-config" doc:id="4de283ed-d88f-45f9-9d78-6ae4686b6f2b" name="post:\accounts:application\json:p-account-api-config"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that" doc:id="7b57b541-5319-4a68-8b74-7f06b1b9a69a" is="#[MunitTools::equalTo('Account created Successfully')]" expression="#[payload.message]"/>
		</munit:validation>
	</munit:test>
