				<munit:payload value="#[MunitTools::getResourceAsString('postAccountReuest.json')]" mediaType="application/json" />
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to post:\accounts:application\json:p-account-api-config" doc:id="1420e47b-fb4a-49f1-aa4d-00a238414d0c" name="post:\accounts:application\json:p-account-api-config" />
